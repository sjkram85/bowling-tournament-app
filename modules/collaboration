"""Real-time collaboration and TD-to-TD chat utilities."""

import datetime
from db_state import get_connection

def update_staff_presence(username: str, display_name: str, role: str, tournament_id: int | None) -> None:
    """Record or update the staff member's current active tournament and heartbeat."""
    conn = get_connection()
    try:
        with conn:
            conn.execute(
                """
                INSERT INTO staff_presence (username, display_name, role, current_tournament_id, last_seen)
                VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
                ON CONFLICT(username) DO UPDATE SET
                    display_name = excluded.display_name,
                    role = excluded.role,
                    current_tournament_id = excluded.current_tournament_id,
                    last_seen = CURRENT_TIMESTAMP
                """,
                (username, display_name, role, tournament_id),
            )
    finally:
        conn.close()

def get_active_staff_members() -> list[dict]:
    """Retrieve all staff members active within the last 5 minutes."""
    conn = get_connection()
    try:
        rows = conn.execute(
            """
            SELECT p.*, t.name as tournament_name 
            FROM staff_presence p
            LEFT JOIN tournaments t ON p.current_tournament_id = t.id
            WHERE datetime(p.last_seen) >= datetime('now', '-5 minutes')
            ORDER BY p.last_seen DESC
            """
        ).fetchall()
        return [dict(r) for r in rows]
    finally:
        conn.close()

def get_chat_messages(limit: int = 50) -> list[dict]:
    """Retrieve recent TD chat messages."""
    conn = get_connection()
    try:
        rows = conn.execute(
            "SELECT * FROM td_chat_messages ORDER BY id DESC LIMIT ?", (limit,)
        ).fetchall()
        return [dict(r) for r in reversed(rows)]
    finally:
        conn.close()

def send_chat_message(sender_name: str, message: str) -> None:
    """Post a new message to the TD chat channel."""
    if not message.strip():
        return
    conn = get_connection()
    try:
        with conn:
            conn.execute(
                "INSERT INTO td_chat_messages (sender_name, message) VALUES (?, ?)",
                (sender_name, message.strip()),
            )
    finally:
        conn.close()